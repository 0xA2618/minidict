# MiniDict 本地环境变量配置示例
# 复制此文件为 .env 并填入你的 API Key，运行 ./build.sh 即可自动编译注入配置
# .env 已被 .gitignore 忽略，不会提交到 GitHub

# OpenAI / DeepSeek / 兼容接口配置
OPENAI_API_KEY=
OPENAI_URL=https://api.deepseek.com/v1/chat/completions
OPENAI_MODEL=deepseek-chat

# 默认翻译引擎：openAI / myMemory / youdao
DEFAULT_ENGINE=myMemory

# 有道智云配置（可选）
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=
